<?xml-model uri="https://xtriples.lod.academy/xtriples.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!-- XTriples configuration for making for SEED DTS location information
    

USAGE:
target/bin/xslt.sh \
    -s:recipes/tei/dts-seed-path.xml \
    -xsl:xsl/extract-param-doc.xsl \
    source-uri=../dts-transformations/test/john.xml

-->
<xtriples xmlns:xi="http://www.w3.org/2001/XInclude">
    <configuration>
        <xi:include href="local.xml" xpointer="vocabularies">
            <xi:fallback>
                <vocabularies>
                    <vocabulary prefix="ed" uri="http://edition.com/resources/"/>
                    <vocabulary prefix="trees" uri="http://edition.com/citationTrees#"/>
                </vocabularies>
            </xi:fallback>
        </xi:include>
        <vocabularies>
            <vocabulary prefix="dts" uri="https://w3id.org/dts/api#"/>
            <vocabulary prefix="seed" uri="https://raw.githubusercontent.com/SCDH/seed-xc/refs/heads/main/dts/src/main/resources/META-INF/resources/semantics/"/>
            <vocabulary prefix="rdf" uri="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
            <vocabulary prefix="rdfs" uri="http://www.w3.org/2000/01/rdf-schema#"/>
            <vocabulary prefix="tei" uri="http://www.tei-c.org/ns/1.0"/>
            <vocabulary prefix="utils" uri="http://scdh.uni-muenster.de/xtriples/utils/"/>
            <vocabulary prefix="owl" uri=" http://www.w3.org/2002/07/owl# "/>
        </vocabularies>
        <triples>

            <!-- assign citation tree to DTS resource, preferring dts:id#1 over utils:relative-path#1 and over the bare file URI -->
            <statement>
                <condition>/exists(function-lookup(xs:QName('dts:resource-uri'), 1))</condition>
                <subject prefix="ed">/dts:id(/)</subject>
                <predicate prefix="seed">location</predicate>
                <object type="bnode">/replace(document-uri(/), '\p{P}', '_') || '_seedLocation'</object>
            </statement>
            <statement>
                <condition>/exists(function-lookup(xs:QName('utils:relative-path'), 1)) and not(exists(function-lookup(xs:QName('dts:id'), 1)))</condition>
                <subject prefix="ed">/utils:relative-path(/)</subject>
                <predicate prefix="seed">location</predicate>
                <object type="bnode">/replace(document-uri(/), '\p{P}', '_') || '_seedLocation'</object>
            </statement>
            <statement>
                <condition>/not(exists(function-lookup(xs:QName('utils:relative-path'), 1)) or exists(function-lookup(xs:QName('dts:id'), 1)))</condition>
                <subject prefix="ed">/document-uri(/)</subject>
                <predicate prefix="seed">location</predicate>
                <object type="bnode">/replace(document-uri(/), '\p{P}', '_') || '_seedLocation'</object>
            </statement>

            <!-- add the informative statements -->
            <statement>
                <subject type="bnode">/replace(document-uri(/), '\p{P}', '_') || '_seedLocation'</subject>
                <predicate prefix="rdf">type</predicate>
                <object type="uri" prefix="seed">Path</object>
            </statement>
            <statement>
                <condition>/exists(function-lookup(xs:QName('utils:relative-path'), 1))</condition>
                <subject type="bnode">/replace(document-uri(/), '\p{P}', '_') || '_seedLocation'</subject>
                <predicate prefix="seed">path</predicate>
                <object type="literal">/utils:relative-path(/)</object>
            </statement>
            <statement>
                <condition>/not(exists(function-lookup(xs:QName('utils:relative-path'), 1)))</condition>
                <subject type="bnode">/replace(document-uri(/), '\p{P}', '_') || '_seedLocation'</subject>
                <predicate prefix="seed">path</predicate>
                <object type="literal">/document-uri(/)</object>
            </statement>

        </triples>
    </configuration>
    <collection uri=".">
    </collection>
</xtriples>
