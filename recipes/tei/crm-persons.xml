<?xml version="1.0" encoding="UTF-8"?>
<!-- XTriples configuration for extracting CRM person data from a TEI personography
- birth
- death

TODO:
- flourish
- gender/sex
- traits
- ...

Note, that identifiers and categorizations are extracted by crm-entities.xml!

USAGE:
target/bin/xslt.sh -xsl:xsl/extract-param-doc.xsl -s:recipes/tei/crm-entity-names.xml source-uri=EDITION/places.xml -xi

-->
<?xml-model href="../../schema/xtriples.rng"?>
<xtriples xmlns:xi="http://www.w3.org/2001/XInclude">
    <configuration>
        <xi:include href="local.xml" xpointer="vocabularies">
            <xi:fallback>
                <vocabularies>
                    <vocabulary prefix="ent" uri="http://edition.com/entities/"/>
                    <vocabulary prefix="prs" uri="http://edition.com/entities/person#"/>
                    <vocabulary prefix="plc" uri="http://edition.com/entities/place#"/>
                    <vocabulary prefix="org" uri="http://edition.com/entities/org#"/>
                    <vocabulary prefix="evt" uri="http://edition.com/entities/event#"/>
                </vocabularies>
            </xi:fallback>
        </xi:include>
        <vocabularies>
            <vocabulary prefix="crm" uri="http://www.cidoc-crm.org/cidoc-crm/"/>
            <vocabulary prefix="lrm" uri="http://iflastandards.info/ns/lrm/lrmoo/"/>
            <vocabulary prefix="sdh" uri="https://sdhss.org/ontology/core/"/>
            <vocabulary prefix="oa" uri="http://www.w3.org/ns/oa#"/>
            <vocabulary prefix="rdf" uri="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
            <vocabulary prefix="rdfs" uri="http://www.w3.org/2000/01/rdf-schema#"/>
            <vocabulary prefix="tei" uri="http://www.tei-c.org/ns/1.0"/>
            <vocabulary prefix="utils" uri="http://scdh.uni-muenster.de/xtriples/utils/"/>
            <vocabulary prefix="owl" uri=" http://www.w3.org/2002/07/owl# "/>
        </vocabularies>
        <triples>
            <!-- CRM birth -->
            <statement>
                <condition>/exists(tei:birth)</condition>
                <subject type="bnode">/concat('birth_', @xml:id)</subject>
                <predicate prefix="crm">P98_brought_into_life</predicate>
                <object type="uri" prefix="prs">/@xml:id</object>
            </statement>
            <statement>
                <condition>/exists(tei:birth)</condition>
                <subject type="bnode">/concat('birth_', @xml:id)</subject>
                <predicate prefix="rdf">type</predicate>
                <object type="uri" prefix="crm">E67_Birth</object>
            </statement>
            <statement>
                <condition>/exists(tei:birth)</condition>
                <subject type="bnode">/concat('birth_', @xml:id)</subject>
                <predicate prefix="crm">P4_has_time-span</predicate>
                <object type="bnode">/concat('birthspan_', @xml:id)</object>
            </statement>
            <statement>
                <condition>/exists(tei:birth)</condition>
                <subject type="bnode">/concat('birthspan_', @xml:id)</subject>
                <predicate prefix="rdf">type</predicate>
                <object type="uri" prefix="crm">E52_Time-Span</object>
            </statement>
            <statement>
                <!-- ISO8601 date, i.e., gregorian only -->
                <!-- what about @not-before and @not-after? -->
                <condition>/exists(tei:birth[@when-iso or (@calendar='gregorian' and @when)])</condition>
                <subject type="bnode">/concat('birthspan_', @xml:id)</subject>
                <predicate prefix="crm">P82_at_some_time_within</predicate>
                <object type="literal" datatype="dateTime">/(tei:birth/@when-iso | tei:birth[@calendar='gregorian' and @when]/@when)[1]</object>
            </statement>
            <statement repeat="{/count(tei:birth)}">
                <subject type="bnode">/concat('birthspan_', @xml:id)</subject>
                <predicate prefix="crm">P78</predicate>
                <object type="bnode">/concat('birthspan_appellation_', $repeatIndex, '_', @xml:id)</object>
            </statement>
            <statement repeat="{/count(tei:birth)}">
                <subject type="bnode">/concat('birthspan_appellation_', $repeatIndex, '_', @xml:id)</subject>
                <predicate prefix="rdf">type</predicate>
                <object type="uri" prefix="crm">E49</object>
            </statement>
            <statement repeat="{/count(tei:birth)}">
                <subject type="bnode">/concat('birthspan_appellation_', $repeatIndex, '_', @xml:id)</subject>
                <!-- sdh:P21 = sdh:P100_has_value see https://ontome.net/property/1843/namespace/3#identification -->
                <predicate prefix="sdh">P21</predicate>
                <!-- serialize attributes? -->
                <object type="literal">/tei:birth[$repeatIndex]/normalize-space(.) || ./tei:birth[$repeatIndex][@calendar]/concat(' (', @calendar, ')')</object>
            </statement>
            <statement repeat="{/count(tei:birth)}">
                <subject type="bnode">/concat('birthspan_appellation_', $repeatIndex, '_', @xml:id)</subject>
                <predicate prefix="crm">P72_has_language</predicate>
                <object type="literal">/tei:birth[$repeatIndex]/(ancestor-or-self::*/@xml:lang)[last()]</object>
            </statement>

            <!-- CRM death -->
            <statement>
                <condition>/exists(tei:death)</condition>
                <subject type="bnode">/concat('death_', @xml:id)</subject>
                <predicate prefix="crm">P100_was_death_of</predicate>
                <object type="uri" prefix="prs">/@xml:id</object>
            </statement>
            <statement>
                <condition>/exists(tei:death)</condition>
                <subject type="bnode">/concat('death_', @xml:id)</subject>
                <predicate prefix="rdf">type</predicate>
                <object type="uri" prefix="crm">E69_Death</object>
            </statement>
            <statement>
                <condition>/exists(tei:death)</condition>
                <subject type="bnode">/concat('death_', @xml:id)</subject>
                <predicate prefix="crm">P4_has_time-span</predicate>
                <object type="bnode">/concat('deathspan_', @xml:id)</object>
            </statement>
            <statement>
                <condition>/exists(tei:death)</condition>
                <subject type="bnode">/concat('deathspan_', @xml:id)</subject>
                <predicate prefix="rdf">type</predicate>
                <object type="uri" prefix="crm">E52_Time-Span</object>
            </statement>
            <statement>
                <!-- ISO8601 date, i.e., gregorian only -->
                <condition>/exists(tei:death[@when-iso or (@calendar='gregorian' and @when)])</condition>
                <subject type="bnode">/concat('deathspan_', @xml:id)</subject>
                <predicate prefix="crm">P82_at_some_time_within</predicate>
                <object type="literal" datatype="dateTime">/(tei:death/@when-iso | tei:death[@calendar='gregorian' and @when]/@when)[1]</object>
            </statement>
            <statement repeat="{/count(tei:death)}">
                <subject type="bnode">/concat('deathspan_', @xml:id)</subject>
                <predicate prefix="crm">P78</predicate>
                <object type="bnode">/concat('deathspan_appellation_', $repeatIndex, '_', @xml:id)</object>
            </statement>
            <statement repeat="{/count(tei:death)}">
                <subject type="bnode">/concat('deathspan_appellation_', $repeatIndex, '_', @xml:id)</subject>
                <predicate prefix="rdf">type</predicate>
                <object type="uri" prefix="crm">E49</object>
            </statement>
            <statement repeat="{/count(tei:death)}">
                <subject type="bnode">/concat('deathspan_appellation_', $repeatIndex, '_', @xml:id)</subject>
                <!-- sdh:P21 = sdh:P100_has_value see https://ontome.net/property/1843/namespace/3#identification -->
                <predicate prefix="sdh">P21</predicate>
                <!-- serialize attributes? -->
                <object type="literal">/tei:death[$repeatIndex]/normalize-space(.) || ./tei:death[$repeatIndex][@calendar]/concat(' (', @calendar, ')')</object>
            </statement>
            <statement repeat="{/count(tei:death)}">
                <subject type="bnode">/concat('deathspan_appellation_', $repeatIndex, '_', @xml:id)</subject>
                <predicate prefix="crm">P72_has_language</predicate>
                <object type="literal">/tei:death[$repeatIndex]/(ancestor-or-self::*/@xml:lang)[last()]</object>
            </statement>

        </triples>
    </configuration>
    <collection uri=".">
        <resource uri="{ ( //tei:person )[@xml:id][@xml:id ne 'TEMPLATE'] }"/>
    </collection>
</xtriples>
