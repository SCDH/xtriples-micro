<?xml-model uri="https://xtriples.lod.academy/xtriples.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!-- XTriples configuration for extracting the citation tree data required for DTS' collection endpoint
    

USAGE:
target/bin/xslt.sh \
    -s:recipes/tei/seed-dts-citation-trees.xml \
    -xsl:xsl/extract-param-doc.xsl \
    source-uri=../dts-transformations/test/john.xml

About the code:
Using /replace(document-uri(/), '\p{P}', '_') makes bnodes work with any TEI and
without requiring special functions in the scope.
-->
<xtriples xmlns:xi="http://www.w3.org/2001/XInclude">
    <configuration>
        <xi:include href="local.xml" xpointer="vocabularies">
            <xi:fallback>
                <vocabularies>
                    <vocabulary prefix="ed" uri="http://edition.com/resources/"/>
                    <vocabulary prefix="trees" uri="http://edition.com/citationTrees#"/>
                </vocabularies>
            </xi:fallback>
        </xi:include>
        <vocabularies>
            <vocabulary prefix="dts" uri="https://w3id.org/dts/api#"/>
            <vocabulary prefix="rdf" uri="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
            <vocabulary prefix="tei" uri="http://www.tei-c.org/ns/1.0"/>
            <vocabulary prefix="utils" uri="http://scdh.uni-muenster.de/xtriples/utils/"/>
        </vocabularies>
        <triples>
            
            <!-- assign citation tree to DTS resource, preferring dts:id#1 over utils:relative-path#1 and over the bare file URI -->
            <statement>
                <condition>/exists(function-lookup(xs:QName('dts:resource-uri'), 1))</condition>
                <subject prefix="ed">/dts:id(/)</subject>
                <predicate prefix="dts">citationTrees</predicate>
                <object type="bnode">/replace(document-uri(/), '\p{P}', '_') || '_citationTree_' || $resourceIndex</object>
            </statement>
            <statement>
                <condition>/exists(function-lookup(xs:QName('utils:relative-path'), 1)) and not(exists(function-lookup(xs:QName('dts:id'), 1)))</condition>
                <subject prefix="ed">/utils:relative-path(/)</subject>
                <predicate prefix="dts">citationTrees</predicate>
                <object type="bnode">/replace(document-uri(/), '\p{P}', '_') || '_citationTree_' || $resourceIndex</object>
            </statement>
            <statement>
                <condition>/not(exists(function-lookup(xs:QName('utils:relative-path'), 1)) or exists(function-lookup(xs:QName('dts:id'), 1)))</condition>
                <subject prefix="ed">/document-uri(/)</subject>
                <predicate prefix="dts">citationTrees</predicate>
                <object type="bnode">/replace(document-uri(/), '\p{P}', '_') || '_citationTree_' || $resourceIndex</object>
            </statement>

            <!-- about the citation tree -->
            <statement>
                <subject type="bnode">/replace(document-uri(/), '\p{P}', '_') || '_citationTree_' || $resourceIndex</subject>
                <predicate prefix="rdf">type</predicate>
                <object type="uri" prefix="dts">CitationTree</object>
            </statement>
            <statement>
                <condition>/exists(@n)</condition>
                <subject type="bnode">/replace(document-uri(/), '\p{P}', '_') || '_citationTree_' || $resourceIndex</subject>
                <predicate prefix="dts">identifier</predicate>
                <object type="uri" prefix="trees">/@n</object>
            </statement>
            <statement>
                <condition>/exists(@n)</condition>
                <subject type="bnode">/replace(document-uri(/), '\p{P}', '_') || '_citationTree_' || $resourceIndex</subject>
                <predicate prefix="dts">citeStructure</predicate>
                <object type="uri" prefix="trees">/child::tei:citeStructure ! concat(replace(document-uri(/), '\p{P}', '_'), '_citationTree_', $resourceIndex, '_',  generate-id(.))</object>
            </statement>
            
            <!-- create statements from recursive citeStructure elements -->
            <statement repeat="{/count(./descendant::tei:citeStructure)}">
                <condition>/exists(/descendant::tei:citeStructure[$repeatIndex]/tei:citeStructure)</condition>
                <subject type="bnode">/replace(document-uri(/), '\p{P}', '_') || '_citationTree_' || $resourceIndex || '_' || generate-id(./descendant::tei:citeStructure[$repeatIndex])</subject>
                <predicate prefix="dts">citeStructure</predicate>
                <object type="bnode">/descendant::tei:citeStructure[$repeatIndex]/tei:citeStructure ! concat(replace(document-uri(/), '\p{P}', '_'), '_citationTree_', $resourceIndex, '_',  generate-id(.))</object>
            </statement>
            <statement repeat="{/count(./descendant::tei:citeStructure)}">
                <condition>/exists(/descendant::tei:citeStructure[$repeatIndex]/@unit)</condition>
                <subject type="bnode">/replace(document-uri(/), '\p{P}', '_') || '_citationTree_' || $resourceIndex || '_' || generate-id(./descendant::tei:citeStructure[$repeatIndex])</subject>
                <predicate prefix="rdf">type</predicate>
                <object type="uri" prefix="dts">CiteStructure</object>
            </statement>
            <statement repeat="{/count(./descendant::tei:citeStructure)}">
                <condition>/exists(/descendant::tei:citeStructure[$repeatIndex]/@unit)</condition>
                <subject type="bnode">/replace(document-uri(/), '\p{P}', '_') || '_citationTree_' || $resourceIndex || '_' || generate-id(./descendant::tei:citeStructure[$repeatIndex])</subject>
                <predicate prefix="dts">citeType</predicate>
                <object type="literal">/descendant::tei:citeStructure[$repeatIndex]/@unit</object>
            </statement>
        </triples>
    </configuration>
    <collection uri=".">
        <resource uri="{ //tei:refsDecl }"/>
    </collection>
</xtriples>
